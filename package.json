{
  "name": "code-racer",
  "version": "0.0.0",
  "private": true,
  "description": "A terminal-aesthetic typing racer for code snippets.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "client"
  ],
  "scripts": {
